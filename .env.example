# Copier ce fichier en .env et définir les variables dans le shell ou via votre gestionnaire de secrets.
DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite par défaut. Pour PostgreSQL, définir DB_ENGINE=postgres et les valeurs ci-dessous.
DB_ENGINE=sqlite
DB_NAME=pharmagest
DB_USER=pharmagest
DB_PASSWORD=mot-de-passe-a-remplacer
DB_HOST=127.0.0.1
DB_PORT=5432
